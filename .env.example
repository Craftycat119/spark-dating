# Скопируйте в .env и заполните
APP_NAME=COFI
BASE_URL=https://your-domain.ru
SECRET_KEY=замените-на-длинную-случайную-строку
DEV_MODE=0
COOKIE_SECURE=1

# Админы (через запятую): эти почты получают доступ к /admin
ADMIN_EMAILS=you@mail.ru

# Почта для кодов подтверждения.
# Личный Outlook.com / Hotmail (пароль Microsoft больше не принимает, нужен вход через Microsoft):
#   1) получите OUTLOOK_CLIENT_ID (README, раздел «Почта Outlook»)  2) python -m app.cli outlook-login
SMTP_AUTH=outlook
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SSL=0
SMTP_USER=you@outlook.com
SMTP_FROM=COFI <you@outlook.com>
OUTLOOK_CLIENT_ID=
# Яндекс / Mail.ru / Gmail: SMTP_AUTH=password, свой SMTP_HOST, SMTP_SSL=1, SMTP_PORT=465 и пароль приложения
SMTP_PASSWORD=

# Вход через Telegram: создайте бота у @BotFather (/newbot) и вставьте токен. Домен указывать не нужно
TELEGRAM_BOT_TOKEN=

# Проверка лица: opencv (настоящая) или dev (выключена, только для разработки)
FACE_MODE=opencv

# Звонки. STUN уже встроен. Чтобы звонки работали через мобильный интернет, нужен TURN (README, раздел «Звонки»):
# адреса через запятую, логин и пароль из кабинета TURN-сервиса
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Группа или человек, куда бот присылает заявки «Помочь» по животным (бот должен быть в группе)
TELEGRAM_REQUESTS_CHAT_ID=
