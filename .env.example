# Скопируйте в .env и заполните
APP_NAME=COFI
BASE_URL=https://your-domain.ru
SECRET_KEY=замените-на-длинную-случайную-строку
DEV_MODE=0
COOKIE_SECURE=1

# Админы (через запятую): эти почты получают доступ к /admin
ADMIN_EMAILS=you@mail.ru

# Почта для кодов подтверждения.
# Личный Outlook.com / Hotmail (пароль Microsoft больше не принимает, нужен вход через Microsoft):
#   1) получите OUTLOOK_CLIENT_ID (README, раздел «Почта Outlook»)  2) python -m app.cli outlook-login
SMTP_AUTH=outlook
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SSL=0
SMTP_USER=you@outlook.com
SMTP_FROM=COFI <you@outlook.com>
OUTLOOK_CLIENT_ID=
# Яндекс / Mail.ru / Gmail: SMTP_AUTH=password, свой SMTP_HOST, SMTP_SSL=1, SMTP_PORT=465 и пароль приложения
SMTP_PASSWORD=

# Вход через Telegram: создайте бота у @BotFather (/newbot) и вставьте токен. Домен указывать не нужно
TELEGRAM_BOT_TOKEN=

# Проверка лица: opencv (настоящая) или dev (выключена, только для разработки)
FACE_MODE=opencv

# Звонки. STUN уже встроен. Чтобы звонки работали через мобильный интернет, нужен TURN (README, раздел «Звонки»):
# адреса через запятую, логин и пароль из кабинета TURN-сервиса
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Кому ещё бот дублирует заявки «Помочь» по питомцам: id и/или @username через запятую, например @volunteer,-100123.
# Человек с @username должен один раз открыть бота и нажать «Запустить»; бот должен состоять в группе
TELEGRAM_REQUESTS_CHAT_ID=
# Куда ведёт кнопка «Написать в Telegram» у питомцев (если у объявления нет своего контакта): @username или t.me/…
TELEGRAM_PETS_CONTACT=
# Группа администрации: заявки по животным и всё, для чего ниже не задано своё место (пусто — каждому админу с Telegram)
TELEGRAM_ADMIN_CHAT_ID=
# Обращения «Нужна помощь» (пусто — в группу администрации)
TELEGRAM_SUPPORT_CHAT_ID=
# Жалобы и предложения (пусто — туда же, куда «Нужна помощь»)
TELEGRAM_COMPLAINTS_CHAT_ID=
# Сообщения рекламодателей (пусто — в группу администрации)
TELEGRAM_ADS_CHAT_ID=
# Во всех строках можно писать id группы (-100…) или @username; человек должен один раз нажать «Запустить» в боте

# Проверка на робота: image (своя картинка), turnstile (Cloudflare, нужны ключи ниже) или off
CAPTCHA=image
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Аудио- и видеозвонки (пока выключены). 1 — включить кнопки звонков в чате
CALLS_ENABLED=0
