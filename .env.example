# Скопируйте в .env и заполните
APP_NAME=COFI
BASE_URL=https://your-domain.ru
SECRET_KEY=замените-на-длинную-случайную-строку
DEV_MODE=0
COOKIE_SECURE=1

# Админы (через запятую): эти почты получают доступ к /admin
ADMIN_EMAILS=you@mail.ru

# Почта (пример для Яндекса; для Gmail — smtp.gmail.com и пароль приложения)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=noreply@your-domain.ru
SMTP_PASSWORD=пароль-приложения
SMTP_FROM=COFI <noreply@your-domain.ru>

# Вход через Telegram: создайте бота у @BotFather и выполните /setdomain
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Проверка лица: opencv (настоящая) или dev (выключена, только для разработки)
FACE_MODE=opencv

# STUN/TURN для звонков. Для звонков через мобильный интернет нужен свой TURN (coturn)
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
